    "@vercel/node": "^5.1.20",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
