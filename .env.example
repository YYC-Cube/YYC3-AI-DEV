# ============================================================
# YYC³ AI 生态系统 - 环境变量示例
# 复制为 .env.local 后填入实际值, 切勿提交 .env.local 到 Git
#
# 部署形态: GitHub Pages (静态) / Docker + Nginx (静态)
# 前端为纯静态 SPA, 运行时变量必须使用 VITE_ 前缀并在构建期注入
# ============================================================

# ===== 应用元信息 =====
VITE_APP_NAME="YYC³ Cloud Intelli-Matrix"
VITE_APP_VERSION="5.1.1"
VITE_APP_ENV=development   # development | staging | production

# ===== 默认 LLM 路由策略 (可选; 用户在前端 Keyring 配置会覆盖) =====
VITE_DEFAULT_LLM_PROVIDER=manual   # openai | anthropic | qwen | deepseek | kimi | manual
VITE_DEFAULT_LLM_STRATEGY=cost     # cost | latency | quality | manual

# ===== 预留: 服务端网关 (当前版本无服务端, 前端直连 Provider) =====
# 说明: 密钥由用户在前端 Keyring (AES-256-GCM) 管理, 以下变量仅未来接入
#       自建网关时使用, 当前代码不读取。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# ===== 监控 (预留, 当前代码未接入) =====
SENTRY_DSN=
POSTHOG_KEY=

# ===== CI/CD (GitHub Actions Secrets) =====
# SNYK_TOKEN=
