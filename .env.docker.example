# Docker Compose 环境变量示例
# 复制为 .env.docker 后填入实际值
VITE_APP_NAME="YYC³ Cloud Intelli-Matrix"
VITE_APP_ENV=production

# LLM Provider Key（当前前端由用户 Keyring 管理，容器侧不读取；
# 若后续接入自建网关，再在此注入并改由服务端转发）
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# 静态站点响应头/域名相关（由 Nginx 配置承载，此处仅留档）
# CORS_ALLOWED_ORIGINS=https://dev.yyc3.vip
